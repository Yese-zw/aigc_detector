@import "../../pages/index/index.wxss";

.page-wrapper {
  background: #0B0B1A;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  color: #fff;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 顶部标题区 */
.header-section {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}
.header-left {
  display: flex;
  flex-direction: column;
}
.page-title {
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}
.page-subtitle {
  font-size: 24rpx;
  color: #6C63FF;
  font-family: monospace;
  font-weight: 600;
}
.btn-gradient-small {
  background: linear-gradient(135deg, #6C63FF, #00D4AA);
  color: white;
  font-size: 26rpx;
  font-weight: bold;
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  margin: 0;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(108, 99, 255, 0.4);
}
.btn-icon {
  margin-right: 8rpx;
  font-size: 30rpx;
}

/* 列表区 */
.key-list {
  flex: 1;
  position: relative;
  z-index: 2;
}

/* 优雅卡片 */
.key-card {
  padding: 0;
  margin-bottom: 30rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.06);
  backdrop-filter: blur(20px);
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.2);
  transition: all 0.3s ease;
}
.key-card.inactive {
  opacity: 0.6;
  filter: grayscale(100%);
}

.key-header {
  padding: 30rpx 30rpx 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.key-title-group {
  display: flex;
  align-items: center;
}
.key-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}
.key-name {
  font-size: 34rpx;
  font-weight: bold;
  color: rgba(255,255,255,0.9);
}

/* 密钥高亮框 */
.key-value-box {
  margin: 0 30rpx 30rpx;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 1px solid rgba(255,255,255,0.05);
}
.key-value {
  font-family: monospace;
  font-size: 24rpx;
  color: #00D4AA;
  word-break: break-all;
  flex: 1;
  margin-right: 20rpx;
}
.copy-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  white-space: nowrap;
}

/* 细分双列数据 */
.stats-grid {
  display: flex;
  background: rgba(255, 255, 255, 0.02);
  border-top: 1px solid rgba(255,255,255,0.05);
  border-bottom: 1px solid rgba(255,255,255,0.05);
}
.stat-item {
  flex: 1;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
}
.stat-item-divider {
  width: 1px;
  background: rgba(255,255,255,0.05);
}
.stat-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  margin-bottom: 12rpx;
}
.stat-value {
  font-size: 36rpx;
  font-weight: 800;
  font-family: monospace;
  color: #fff;
}
.stat-value.quota {
  color: #FFB347;
}

/* 底部操作区 */
.key-footer {
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.key-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.4);
  max-width: 70%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.btn-danger-small {
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 107, 107, 0.1);
  border: 1px solid rgba(255, 107, 107, 0.3);
  color: #FF6B6B;
  font-size: 24rpx;
  font-weight: 500;
}
.btn-danger-small:active {
  background: rgba(255, 107, 107, 0.2);
}

.empty-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 80rpx 0;
  margin-top: 40rpx;
  border-radius: 32rpx;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.8;
}
.empty-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.5);
}
