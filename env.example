# ==================== 应用配置 ====================
APP_NAME="AIGC Detector API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="支持多进程共享登录态的AI检测服务"

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8001
WORKERS=1
RELOAD=false

# ==================== Redis配置 ====================
REDIS_HOST=124.221.97.191
REDIS_PORT=6379
REDIS_PASSWORD=960777365
REDIS_DB=3
REDIS_DECODE_RESPONSES=true

# ==================== 登录态配置 ====================
AUTH_EXPIRE_SECONDS=21600
REDIS_AUTH_KEY=ai_detector_auth

# ==================== AI检测服务配置 ====================
AI_DETECTOR_BASE_URL=https://ai.lanbeike.online
AI_DETECTOR_TIMEOUT=15
LOGIN_TIMEOUT=10

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=logs/ai_detector.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

