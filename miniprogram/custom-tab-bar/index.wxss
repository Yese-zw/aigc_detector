/* ============================================================
   CUSTOM TAB BAR - 液态玻璃底部导航样式
   ============================================================ */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  padding: 0 20rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 120rpx;
  border-radius: 36rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

/* 玻璃背景 */
.tab-bar-bg {
  position: absolute;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: linear-gradient(135deg,
    rgba(20, 20, 43, 0.85) 0%,
    rgba(11, 11, 26, 0.92) 100%
  );
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 36rpx;
  box-shadow:
    0 -4rpx 24rpx rgba(0, 0, 0, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.1);
}

/* 活动指示器 */
.active-indicator {
  position: absolute;
  top: 8rpx;
  width: 80rpx;
  height: 6rpx;
  background: var(--gradient-primary);
  border-radius: 6rpx;
  transition: left 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  box-shadow: 0 2rpx 12rpx rgba(108, 99, 255, 0.5);
}

/* Tab 项 */
.tab-item {
  position: relative;
  z-index: 2;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  transition: all 0.3s ease;
}

.tab-icon-wrap {
  position: relative;
  margin-bottom: 4rpx;
}

.tab-icon {
  font-size: 40rpx;
  transition: all 0.3s ease;
}

.tab-item.active .tab-icon {
  transform: scale(1.15);
}

/* 发光效果 */
.tab-glow {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 60rpx; height: 60rpx;
  background: radial-gradient(circle, rgba(108, 99, 255, 0.35), transparent 70%);
  border-radius: 50%;
  filter: blur(8rpx);
  animation: pulse 2s ease-in-out infinite;
}

.tab-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
  font-weight: 500;
  transition: all 0.3s ease;
}

.tab-item.active .tab-label {
  color: var(--color-primary-light);
  font-weight: 600;
}
