<!-- ============================================================
     ANALYTICS DASHBOARD - 运营数据大屏 (Liquid Glass Design)
     ============================================================ -->
<view class="page-wrapper safe-area-bottom">
  
  <!-- 动态背景光晕 -->
  <view class="bg-blobs">
    <view class="blob blob-1"></view>
    <view class="blob blob-2"></view>
    <view class="blob blob-3"></view>
  </view>

  <scroll-view class="main-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: calc(100vh - {{statusBarHeight}}px - 140rpx); margin-top: {{statusBarHeight}}px;" refresher-enabled="{{true}}" refresher-triggered="{{isRefreshing}}" bindrefresherrefresh="onRefresh" refresher-background="transparent">
    <view class="content-wrapper">

      <!-- 顶部过滤与实时状态 -->
      <view class="filter-row animate-fade-in-up" style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
        <view class="live-status" style="justify-content: flex-start;">
          <view class="pulse-dot"></view>
          <text>{{realtime.online_users || 0}} 人在线</text>
        </view>
        
        <view class="update-time" wx:if="{{lastUpdate}}" style="font-size: 22rpx; color: rgba(255, 255, 255, 0.5);">
          <text>↺ {{lastUpdate}}</text>
        </view>
      </view>

      <!-- 第一行：核心指标大卡 (收入与用户) -->
      <view class="hero-grid animate-fade-in-up animate-delay-1">
        <!-- 总收入 -->
        <view class="hero-card glass-card glass-card-primary">
          <view class="hero-icon-bg"><text>💰</text></view>
          <text class="hero-title">总计收入 (元)</text>
          <text class="hero-value">¥ {{f_revenue}}</text>
          <view class="hero-footer">
            <text class="footer-label">今日新增</text>
            <text class="footer-val highlight-green">+¥ {{f_today_rev}}</text>
          </view>
        </view>

        <!-- 总用户 -->
        <view class="hero-card glass-card glass-card-secondary">
          <view class="hero-icon-bg"><text>👥</text></view>
          <text class="hero-title">总用户数 (人)</text>
          <text class="hero-value">{{f_total_users}}</text>
          <view class="hero-footer">
            <text class="footer-label">今日新增</text>
            <text class="footer-val highlight-blue">+{{f_today_users}}</text>
          </view>
        </view>
      </view>

      <!-- 第二行：转化与活跃漏斗 -->
      <view class="section-title animate-fade-in-up animate-delay-2">
        <text class="section-icon">📈</text><text>用户转化分析</text>
      </view>
      
      <view class="bento-grid animate-fade-in-up animate-delay-2">
        <!-- 横向长卡：转化率 -->
        <view class="bento-card bento-wide glass-card">
          <view class="funnel-metrics">
            <view class="funnel-item">
              <text class="f-lbl">注册转活跃</text>
              <text class="f-val">{{conversion.reg_to_active_rate || 0}}%</text>
            </view>
            <view class="funnel-arrow">→</view>
            <view class="funnel-item">
              <text class="f-lbl">活跃转付费</text>
              <text class="f-val">{{conversion.active_to_pay_rate || 0}}%</text>
            </view>
            <view class="funnel-arrow">→</view>
            <view class="funnel-item accent">
              <text class="f-lbl">整体付费率</text>
              <text class="f-val">{{conversion.overall_pay_rate || 0}}%</text>
            </view>
          </view>
          
          <view class="conversion-bars">
            <view class="bar-row">
              <text>活跃数 ({{conversion.active_users || 0}})</text>
              <view class="bar-track"><view class="bar-fill blue" style="width: {{conversion.active_users / (conversion.total_users || 1) * 100}}%"></view></view>
            </view>
            <view class="bar-row">
              <text>付费数 ({{conversion.paid_users || 0}})</text>
              <view class="bar-track"><view class="bar-fill purple" style="width: {{conversion.paid_users / (conversion.total_users || 1) * 100}}%"></view></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 第三行：四宫格指标 (订单、积分、代理、近期数据) -->
      <view class="section-title animate-fade-in-up animate-delay-3">
        <text class="section-icon">📊</text><text>业务指标</text>
      </view>

      <view class="bento-grid quad-grid animate-fade-in-up animate-delay-3">
        
        <!-- 订单数据 -->
        <view class="bento-card glass-card">
          <text class="card-icon">🛍️</text>
          <text class="sm-title">总订单量</text>
          <text class="lg-val">{{f_total_orders}}</text>
          <view class="sm-row">今日: <text class="green">+{{f_today_orders}}</text></view>
          <view class="sm-prog-lbl">完成率: {{orders.completion_rate || 0}}%</view>
        </view>

        <!-- 积分流转 -->
        <view class="bento-card glass-card">
          <text class="card-icon">💎</text>
          <text class="sm-title">积分利用率</text>
          <text class="lg-val cyan">{{points.utilization_rate || 0}}%</text>
          <view class="sm-row">下发: {{points.distributed || 0}}</view>
          <view class="sm-row">消耗: {{points.consumed || 0}}</view>
        </view>

        <!-- 代理与ARPU -->
        <view class="bento-card glass-card">
          <text class="card-icon">🤝</text>
          <text class="sm-title">代理与价值</text>
          <text class="lg-val warm">¥{{revenue.arpu || 0.00}}</text>
          <view class="sm-row">代理数: {{agents.total || 0}}</view>
          <view class="sm-row">代理抽成: {{agents.total_commission || 0}}</view>
        </view>

        <!-- 近一小时 -->
        <view class="bento-card glass-card">
          <text class="card-icon">⏱️</text>
          <text class="sm-title">最近 1 小时</text>
          <text class="lg-val purple">¥{{realtime.recent_1h.revenue || 0}}</text>
          <view class="sm-row">新增用户: {{realtime.recent_1h.new_users || 0}}</view>
          <view class="sm-row">新增订单: {{realtime.recent_1h.new_orders || 0}}</view>
        </view>

      </view>

      <!-- 底部安全缓冲 -->
      <view style="height: 60rpx;"></view>

    </view>
  </scroll-view>

  <!-- 全屏加载动画 -->
  <view class="loading-mask" wx:if="{{isLoading}}">
    <view class="spinner"></view>
  </view>
</view>
