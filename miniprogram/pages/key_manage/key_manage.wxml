<view class="page-wrapper container">
  <view class="bg-blobs">
    <view class="blob blob-1"></view>
    <view class="blob blob-2"></view>
    <view class="blob blob-3"></view>
  </view>

  <!-- 顶部概览指标 -->
  <view class="hero-grid animate-fade-in-up animate-delay-1" style="margin-bottom: 40rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 24rpx;">
    <view class="hero-card glass-card" style="padding: 24rpx;">
      <text class="hero-title" style="font-size: 20rpx; opacity: 0.6;">总分发额度</text>
      <text class="hero-value" style="font-size: 32rpx; margin: 12rpx 0; display: block;">{{totalQuota}}</text>
      <text style="font-size: 18rpx; color: #00D4AA;">Active: {{activeKeys}}</text>
    </view>
    <view class="hero-card glass-card" style="padding: 24rpx;">
      <text class="hero-title" style="font-size: 20rpx; opacity: 0.6;">密钥总数</text>
      <text class="hero-value" style="font-size: 32rpx; margin: 12rpx 0; display: block;">{{keys.length}}</text>
      <text style="font-size: 18rpx; opacity: 0.4;">Total Provisioned</text>
    </view>
  </view>

  <view class="header-section animate-fade-in-up">
    <view class="header-left">
      <text class="page-title">下游分发管控</text>
      <text class="page-subtitle">API Access Provisioning</text>
    </view>
    <button class="btn-gradient-small" bindtap="openAddModal">
      <text class="btn-icon iconfont icon-plus"></text>新建密钥
    </button>
  </view>

  <scroll-view class="key-list animate-fade-in-up animate-delay-2" scroll-y>
    <view class="key-card glass-card {{item.is_active ? '' : 'inactive'}}" wx:for="{{keys}}" wx:key="key">
      <!-- 头部名称与开关 -->
      <view class="key-header">
        <view class="key-title-group">
          <text class="key-icon iconfont icon-key"></text>
          <text class="key-name">{{item.name || '未命名密钥'}}</text>
        </view>
        <switch checked="{{item.is_active}}" color="#6C63FF" bindchange="toggleActive" data-key="{{item.key}}" />
      </view>

      <!-- 密钥明文框 -->
      <view class="key-value-box" bindtap="copyKey" data-key="{{item.key}}">
        <text class="key-value">{{item.key}}</text>
        <text class="copy-hint">点击复制</text>
      </view>

      <!-- 状态与数据双列格 -->
      <view class="stats-grid">
        <view class="stat-item" bindtap="modifyQuota" data-key="{{item.key}}">
          <text class="stat-label"><text class="iconfont icon-chart" style="font-size: 22rpx; margin-right: 6rpx;"></text>剩余额度 (点击修改)</text>
          <text class="stat-value quota">{{item.quota}}</text>
        </view>
        <view class="stat-item-divider"></view>
        <view class="stat-item">
          <text class="stat-label"><text class="iconfont icon-time" style="font-size: 22rpx; margin-right: 6rpx;"></text>累计调用</text>
          <text class="stat-value">{{item.total_quota - item.quota}}</text>
        </view>
      </view>

      <!-- 底部控制栏 -->
      <view class="key-footer">
        <text class="key-desc">{{item.description || '暂无详细描述...'}}</text>
        <view class="btn-danger-small" bindtap="deleteKey" data-key="{{item.key}}">
          <text>吊销</text>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view wx:if="{{!isLoading && keys.length === 0}}" class="empty-state glass-card">
      <text class="empty-icon iconfont icon-info"></text>
      <text class="empty-text">当前暂无任何下游密钥分发</text>
    </view>
    <view style="height: 100rpx;"></view>
  </scroll-view>

  <!-- 新建 Modal -->
  <view class="modal-root" wx:if="{{showAddModal}}">
    <view class="modal-mask" bindtap="closeModals"></view>
    <view class="modal-card glass-card animate-pop-in">
      <text class="modal-title">新建分发密钥</text>
      <view class="form-group">
        <text class="label">密钥名称</text>
        <input class="input" placeholder="如：代理商-张三" placeholder-class="placeholder-style" bindinput="onNewKeyInput" data-field="name" value="{{newKey.name}}" />
      </view>
      <view class="form-group">
        <text class="label">初始额度 (字符)</text>
        <input class="input" type="number" placeholder-class="placeholder-style" bindinput="onNewKeyInput" data-field="quota" value="{{newKey.quota}}" />
      </view>
      <view class="form-group">
        <text class="label">备注描述</text>
        <textarea class="textarea" placeholder="选填..." placeholder-class="placeholder-style" bindinput="onNewKeyInput" data-field="description" value="{{newKey.description}}" />
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModals">取消</button>
        <button class="btn-confirm" bindtap="confirmAddKey">立即创建</button>
      </view>
    </view>
  </view>

  <!-- 调整额度 Modal -->
  <view class="modal-root" wx:if="{{showQuotaModal}}">
    <view class="modal-mask" bindtap="closeModals"></view>
    <view class="modal-card glass-card animate-pop-in">
      <text class="modal-title">调整可用额度</text>
      <view class="form-group">
        <text class="label">追加额度 (正数为加，负数为减)</text>
        <input class="input" type="number" focus placeholder-class="placeholder-style" bindinput="onQuotaInput" value="{{quotaToAdd}}" />
      </view>
      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModals">取消</button>
        <button class="btn-confirm" bindtap="confirmQuota">确认调整</button>
      </view>
    </view>
  </view>
</view>
