@import "../index/index.wxss";

/* 额外针对改写页的样式 */

.combo-selector {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
}

.combo-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.7);
}

.combo-options {
  display: flex;
  background: rgba(255,255,255,0.06);
  border-radius: 999rpx;
  padding: 6rpx;
  border: 1rpx solid rgba(255,255,255,0.1);
}

.combo-option {
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.5);
  transition: all 0.3s;
}

.combo-option.active {
  background: var(--color-secondary);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0, 212, 170, 0.4);
}

.combo-hint {
  font-size: 22rpx;
  color: var(--color-warning);
  position: absolute;
  top: 100%;
  left: 0;
  margin-top: 8rpx;
  animation: fadeIn 0.3s;
}

/* 结果区样式扩展 */
.copy-btn {
  margin-left: auto;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  background: rgba(108, 99, 255, 0.2);
  color: var(--color-primary-light);
  border-radius: 999rpx;
  border: 1rpx solid rgba(108, 99, 255, 0.3);
}

.txt-result {
  background: rgba(255, 255, 255, 0.05);
  padding: 24rpx;
  border-radius: 16rpx;
  min-height: 200rpx;
}

.txt-content {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.6;
}
