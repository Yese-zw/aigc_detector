/* 延续之前极具质感的液态玻璃风格 */
@import "../index/index.wxss";

.page-wrapper {
  background: #0B0B1A;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  color: #fff;
}

/* 顶部 Header */
.header {
  position: relative;
  z-index: 10;
  padding: 0 40rpx;
  background: linear-gradient(180deg, rgba(11,11,26,0.95), rgba(11,11,26,0));
}
.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  margin-bottom: 20rpx;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.header-icon {
  font-size: 40rpx;
}
.header-info {
  display: flex;
  flex-direction: column;
}
.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.2;
}
.header-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

.refresh-btn {
  width: 60rpx; height: 60rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.refresh-icon {
  color: #fff;
  font-size: 28rpx;
}
.spinning .refresh-icon {
  animation: spin 1s linear infinite;
}

/* 主容器 */
.main-scroll {
  position: relative;
  z-index: 5;
  height: calc(100vh - 180rpx);
}
.content-wrapper {
  padding: 40rpx;
}

/* 状态栏 */
.status-banner {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}
.status-active .status-dot { background: #00D4AA; box-shadow: 0 0 16rpx #00D4AA; }
.status-active .status-badge { color: #00D4AA; background: rgba(0, 212, 170, 0.1); }
.status-warning .status-dot { background: #FFB347; box-shadow: 0 0 16rpx #FFB347; }
.status-warning .status-badge { color: #FFB347; background: rgba(255, 179, 71, 0.1); }
.status-error .status-dot { background: #FF6B6B; box-shadow: 0 0 16rpx #FF6B6B; }
.status-error .status-badge { color: #FF6B6B; background: rgba(255, 107, 107, 0.1); }

.status-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  margin-right: 24rpx;
}
.status-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.status-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 8rpx;
}
.status-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.status-badge {
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* Token Detail */
.detail-card {
  padding: 32rpx;
  margin-bottom: 40rpx;
}
.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1px dashed rgba(255, 255, 255, 0.1);
}
.detail-row:last-child {
  border-bottom: none;
}
.detail-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}
.detail-value {
  font-size: 24rpx;
  font-family: monospace;
  color: rgba(255, 255, 255, 0.9);
}
.highlight {
  color: var(--color-primary-light);
  font-weight: 700;
}

/* Update Area */
.update-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
}
.auth-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.5;
  margin-bottom: 32rpx;
}

.token-input {
  width: 100%;
  height: 360rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #fff;
  line-height: 1.5;
  word-break: break-all;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.btn-row {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
}
.btn-outline {
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: transparent;
  color: rgba(255, 255, 255, 0.7);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}
.btn-outline[disabled] { opacity: 0.5; }
.btn-gradient {
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 56rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: var(--gradient-primary);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(108, 99, 255, 0.4);
}
.btn-gradient[disabled] { opacity: 0.5; box-shadow: none; }

.bottom-safe {
  height: 180rpx;
}
