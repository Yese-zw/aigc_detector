<view class="page-wrapper container">
  <view class="bg-blobs">
    <view class="blob blob-1"></view>
  </view>
  
  <view class="header-bar animate-fade-in-up">
    <text class="header-title">实时链路与安全记录</text>
    <view class="refresh-btn" bindtap="fetchLogs">↻ 追平最新</view>
  </view>

  <scroll-view class="log-container glass-card animate-fade-in-up animate-delay-1" scroll-y scroll-with-animation scroll-top="{{scrollTop}}">
    <text class="log-text">{{logs || '监听底层容器日志中...'}}</text>
  </scroll-view>
</view>
