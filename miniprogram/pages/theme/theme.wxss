@import "../../pages/index/index.wxss";

.page-wrapper {
  background: #0B0B1A;
  min-height: 100vh;
  position: relative;
  overflow: hidden;
  color: #fff;
  padding: 40rpx;
  box-sizing: border-box;
}

.theme-card {
  padding: 40rpx;
  border-radius: 32rpx;
}

.theme-header {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  text-align: center;
}

.theme-option {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  margin-bottom: 24rpx;
  border: 1px solid transparent;
  transition: all 0.2s ease;
}

.theme-option:active {
  transform: scale(0.98);
}

.theme-option.active {
  background: rgba(108, 99, 255, 0.15);
  border-color: rgba(108, 99, 255, 0.5);
}

.theme-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
}

.theme-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.theme-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.theme-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.5);
}

.theme-check {
  font-size: 40rpx;
  color: #6C63FF;
  font-weight: bold;
}